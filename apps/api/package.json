  "dependencies": {
    "@asset-rise/shared": "*",
    "@supabase/supabase-js": "2.105.3",
    "@trpc/server": "10.45.4",
    "cors": "2.8.6",
    "express": "4.22.1",
    "pg": "8.20.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.19.18",
    "@types/pg": "8.20.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
